/* pages/surge/index.wxss */
.container {
  padding: 24rpx 24rpx 60rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #f4f9ff;
  text-shadow: 0 0 18rpx rgba(79, 195, 247, 0.35);
}
.page-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8fb0d0;
  margin-bottom: 24rpx;
}

.card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(33, 88, 130, 0.5), rgba(13, 43, 77, 0.3));
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.08), 0 6rpx 20rpx rgba(0, 0, 0, 0.22);
  margin-bottom: 16rpx;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #eaf6ff;
}
.tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.tag-live { background: rgba(76, 175, 80, 0.22); color: #b6f0b9; border: 1rpx solid rgba(76, 175, 80, 0.6); }
.tag-sample { background: rgba(255, 214, 10, 0.18); color: #ffe58a; border: 1rpx solid rgba(255, 214, 10, 0.6); }
.tag-fail { background: rgba(255, 82, 82, 0.18); color: #ffc2c2; border: 1rpx solid rgba(255, 82, 82, 0.6); }
.tag-loading { background: rgba(143, 176, 208, 0.18); color: #8fb0d0; border: 1rpx solid rgba(143, 176, 208, 0.5); }

/* 博罗卡 */
.boluo-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.boluo-main {
  display: flex;
  align-items: baseline;
}
.boluo-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #eaf6ff;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.boluo-unit {
  font-size: 26rpx;
  color: #8fb0d0;
  margin-left: 8rpx;
}
.boluo-meta {
  text-align: right;
}
.meta-line {
  font-size: 22rpx;
  color: #8fb0d0;
  line-height: 1.7;
}
.source {
  margin-top: 18rpx;
  font-size: 20rpx;
  color: #6f93b3;
}

/* 台风卡 */
.ty-name {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.ty-label {
  font-size: 22rpx;
  color: #8fb0d0;
  margin-right: 10rpx;
}
.ty-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff9a3c;
  margin-right: 12rpx;
}
.ty-num {
  font-size: 22rpx;
  color: #8fb0d0;
  margin-right: 12rpx;
}
.ty-level {
  font-size: 24rpx;
  color: #ffd9a0;
  background: rgba(255, 154, 60, 0.18);
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 154, 60, 0.5);
}
.ty-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}
.ty-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx 0;
}
.ty-cell .k {
  display: block;
  font-size: 20rpx;
  color: #6f93b3;
}
.ty-cell .v {
  display: block;
  font-size: 26rpx;
  color: #d8e8f6;
  margin-top: 2rpx;
}
.surge-box {
  background: rgba(255, 82, 82, 0.1);
  border: 1rpx solid rgba(255, 82, 82, 0.35);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-top: 4rpx;
}
.surge-label {
  display: block;
  font-size: 20rpx;
  color: #ff9a9a;
  margin-bottom: 6rpx;
}
.surge-text {
  display: block;
  font-size: 24rpx;
  color: #ffd9d9;
  line-height: 1.6;
}

/* 说明 */
.note {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  font-size: 22rpx;
  line-height: 1.65;
  color: #8fb0d0;
  margin-bottom: 16rpx;
  text-align: justify;
}
.note-warn {
  background: rgba(255, 214, 10, 0.07);
  border: 1rpx solid rgba(255, 214, 10, 0.25);
  color: #d9c89a;
}
.note-src {
  font-size: 20rpx;
  color: #5f83a3;
}

.refresh {
  margin: 24rpx auto 0;
  width: 280rpx;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(79, 195, 247, 0.22), rgba(33, 150, 243, 0.16));
  border: 1rpx solid rgba(79, 195, 247, 0.5);
  color: #cfeefd;
  font-size: 26rpx;
}
